#!/usr/bin/env bash
# Pre-push hook for reserving-kernels:
#   - When the Rust working tree is clean: runs rustfmt, clippy (-D warnings),
#     unit/integration/doc tests before pushing to remote.
#   - When unstaged Rust edits exist (e.g. concurrent mesh/agent work): validates
#     rustfmt on committed HEAD files touched since upstream so pushes stay safe
#     without blocking on unrelated unstaged WIP.
#
# Bypass in an emergency with: SKIP_HOOKS=1 git push ...

set -euo pipefail

if [[ "${SKIP_HOOKS:-0}" == "1" ]]; then
  exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-push: cargo not found in PATH; skipping checks." >&2
  exit 0
fi

if ! git diff --quiet -- '*.rs'; then
  echo "pre-push: unstaged .rs edits detected; checking rustfmt on committed HEAD changes only."
  BASE="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || echo 'HEAD~1')"
  CHANGED_RS=()
  while IFS= read -r -d '' file; do
    CHANGED_RS+=("$file")
  done < <(git diff --name-only --diff-filter=ACMR -z "$BASE...HEAD" -- '*.rs' 2>/dev/null || true)

  FAILED=0
  for file in "${CHANGED_RS[@]}"; do
    if ! diff -u \
      --label "HEAD/$file" <(git show "HEAD:$file") \
      --label "rustfmt/$file" <(git show "HEAD:$file" | rustfmt --edition 2024); then
      FAILED=1
    fi
  done
  if [[ "$FAILED" -ne 0 ]]; then
    echo "pre-push: committed Rust changes fail rustfmt; format before pushing." >&2
    exit 1
  fi
  echo "pre-push: committed HEAD rustfmt check passed (skipped full clippy/test due to unstaged .rs edits)."
  exit 0
fi

echo "pre-push: running CI checks (fmt, clippy, rustdoc, tests, wasm, benches)..."
cargo fmt --all -- --check
cargo clippy --all-targets --no-default-features -- -D warnings
cargo clippy --all-targets --all-features -- -D warnings
cargo clippy --lib --all-features -- -D warnings -D clippy::unwrap_used -D clippy::panic
RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --all-features
cargo test --lib --tests --all-features
cargo test --doc --all-features
cargo check --benches --release

if command -v rustup >/dev/null 2>&1; then
  if rustup toolchain list 2>/dev/null | grep -q '^1\.97\.0'; then
    echo "pre-push: checking MSRV 1.97.0..."
    cargo +1.97.0 check --lib --tests --examples --no-default-features
  fi
  if rustup target list --installed 2>/dev/null | grep -qx 'wasm32-unknown-unknown'; then
    echo "pre-push: building wasm32 release binary..."
    cargo build --release --target wasm32-unknown-unknown --features wasm
    if command -v node >/dev/null 2>&1 && [[ -f scripts/wasm-smoke.mjs ]]; then
      node scripts/wasm-smoke.mjs target/wasm32-unknown-unknown/release/reserving_kernels.wasm
    fi
  fi
fi
